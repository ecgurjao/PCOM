        "type": "byte",
        "bits_per_chunk": "1",
        "endian": "gr.GR_MSB_FIRST"
      },
      "states": {
        "_enabled": true
      }
    },
    {
      "id": "qtgui_time_sink_x_0",
      "type": "qtgui_time_sink_x",
      "parameters": {
        "type": "float",
        "name": "Envolt\u00f3ria (|I/Q|)",
        "samp_rate": "samp_rate",
