        "type": "float",
        "omega": "mm_omega",
        "gain_omega": "mm_gain_omega",
        "mu": "mm_mu",
        "gain_mu": "mm_gain_mu",
        "omega_relative_limit": "mm_omega_rel"
      },
      "states": {
        "_enabled": true
      }
    },
    {
      "id": "blocks_threshold_ff_0",
      "type": "blocks_threshold_ff",
